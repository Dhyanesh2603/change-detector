# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_SECRET_KEY=generate-a-secure-secret-key-min-32-characters-for-production

# Database (PostgreSQL for production, SQLite for local zero-config development)
# Production PostgreSQL URL: postgresql+asyncpg://postgres:postgres@localhost:5432/website_change_detector
# Local SQLite URL:
DATABASE_URL=sqlite+aiosqlite:///./change_detector.db
DATABASE_SYNC_URL=sqlite:///./change_detector.db

# Authentication (JWT)
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage Configuration
# Local storage driver or S3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage_data

# S3 Configuration (Optional if STORAGE_DRIVER=s3)
S3_BUCKET_NAME=website-change-detector-snapshots
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Playwright Browser Automation
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@changedetector.local
SMTP_USE_TLS=true

# Telegram Bot
TELEGRAM_DEFAULT_BOT_TOKEN=
